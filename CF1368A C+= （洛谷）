#include<stdio.h>
void add_sum(int a , int b , int c , int *res) ;
int main()
{
    int T = 0,a=0,b=0,n=0,res=0;
    scanf("%d",&T) ;
    for(int i = 0;i < T ; i++)
    {
        scanf("%d %d %d",&a,&b,&n) ;
        add_sum(a,b,n,&res) ;
        printf("%d\n",res) ;
    }
    return 0 ;
}
void add_sum(int a,int b, int n, int *res)
{
    int times = 0;
    while(a<=n && b <= n)
    {
        if(a > b)
        {
            b += a ;
            times++ ;
        }
        else
        {
            a += b ;
            times++ ;
        }
    }
    *res = times ;
}
